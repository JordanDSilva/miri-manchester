uncommon_names = setdiff(names(photoZ_bc03_snorm_fritz_norm_eazy), names(photoZ_bc03_snorm_norm_eazy))
combined_catalogue = photoZ_bc03_snorm_fritz_norm_eazy # start with Stellar+AGN
