setNames(df_quantiles[, "Q84"], paste0(rownames(df_quantiles), "Q84")),
setNames(df_lo,                 paste0(rownames(df_quantiles), "_lo")),
setNames(df_hi,                 paste0(rownames(df_quantiles), "_hi"))
)
y_quantiles = cbind(y_quantiles, "x" = x_grid)
