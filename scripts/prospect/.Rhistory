LAGN2BHAR = function(epsilon){( 3.154e7 * 1e-7 * (epsilon * 3e8^2)**-1 / 2e30)}
epsilon_samples = runif(n = 100000, min = 0.06, max = 0.4)
LAGN_thresh = 1e44
